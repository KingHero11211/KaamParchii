# Copy to .env.local and enter your key locally. Never use NEXT_PUBLIC_ for secrets.
GNANI_API_KEY=
GEMINI_API_KEY=
# Optional: use a model available to your Google AI Studio project.
GEMINI_MODEL=gemini-3.1-flash-lite

# LiveKit browser voice agent. Keep the key and secret server-side.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Local web app address used by the voice worker for final transcripts.
KAAMPARCHI_APP_URL=http://127.0.0.1:3000
